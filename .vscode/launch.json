{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Compare Swin fp16 implementations",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/compare_kernels.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv2/bin/python",
            "justMyCode": true,
            "args": [
                "swin_fp16/swin_block_fp16_simplified.py",
                "swin_fp16/triton_opus46_copy",
                //"swin_fp16/gpt5-5",
                "swin_fp16/gpt5-5_fix",
                "--precision", "fp16",
                "--warmup", "100",
                "--iters", "1000", 
                "--atol", "1e-2",
                //"--compile-mode", "default"
            ]
        },
        {
            "name": "Compare Elementwise ADD fp16 implementations",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/compare_kernels.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv2/bin/python",
            "justMyCode": true,
            "args": [
                "elementwise_add_fp16/elementwise_add_fp16.py",  // path to reference
                "elementwise_add_fp16/sonnet46",
                "--precision", "fp16",
                //"--compile-mode", "default",
                "--warmup", "100",
                "--iters", "1000",
                "--atol", "1e-2",
                //"--shape", "64", "1024", "1024"
            ]
        }
    ]
}