{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Compare Swin fp16 implementations",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/compare_kernels.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": true,
            "args": [
                "swin_fp16/swin_block_fp16_simplified.py",
                "swin_fp16/triton_opus46_copy",
                "swin_fp16/opus47_v3_ncu",
                "--precision", "fp16",
                "--warmup", "100",
                "--iters", "1000", 
                "--atol", "1e-2",
                "--compile-mode", "default"
            ]
        },
        {
            "name": "Compare Conv Polling fp16 implementations",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/compare_kernels.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": true,
            "args": [
                "conv_pooling_fp16/conv_block_fp16.py",
                "conv_pooling_fp16/opus47_1",
                "--precision", "fp16",
                "--warmup", "100",
                "--iters", "1000", 
                "--atol", "1e-2",
                "--compile-mode", "default"
            ]
        },
        {
            "name": "Compare Conv Polling fp16 CUDA implementations",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/compare_kernels.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": true,
            "args": [
                "conv_pooling_fp16_cuda/reference.py",
                "conv_pooling_fp16_cuda/torch_compile_baseline",
                "conv_pooling_fp16_cuda/opus47_v1",
                "conv_pooling_fp16_cuda/opus47_v2_ncu",
                "conv_pooling_fp16_cuda/opus47_v4_ncu_hw_spec",
                "conv_pooling_fp16_cuda/opus47_v4",
                "--precision", "fp16",
                "--warmup", "100",
                "--iters", "1000", 
                "--atol", "1e-2",
            ]
        },
        {
            "name": "Compare Elementwise ADD fp16 implementations",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/compare_kernels.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": true,
            "args": [
                "elementwise_add_fp16/elementwise_add_fp16.py",  // path to reference
                "elementwise_add_fp16/sonnet46_10r",
                "elementwise_add_fp16/opus47_30r",
                "--precision", "fp16",
                "--compile-mode", "default",
                "--warmup", "200",
                "--iters", "5000",
                "--atol", "1e-2",
                //"--shape", "16", "2048", "2048"
            ]
        },
        {
            "name": "Generate RMSNorm+RoPE fp16 Triton kernel",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/generate_kernels_and_eval.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": true,
            "envFile": "${workspaceFolder}/.env",
            "args": [
                "--task-path", "rmsnorm_rope_fp16/rmsnorm_rope_fp16.py",
                "--base-url", "https://gnai.intel.com/api/providers/openai/v1",           
                "--model-name", "claude-opus-4-7",
                "--language", "triton",
                "--triton-device", "cuda:0",
                //"--target-gpu", "RTX 5090 Mobile",
                "--hw-spec", "k_search/hw_specs/specs/rtx_5090_mobile.json",
                "--wm-stagnation-window", "5",
                "--max-opt-rounds", "30",
                "--world-model",
                "--enable-profiling", "--verbose",
                "--save-solutions",
                "--artifacts-dir", "rmsnorm_rope_fp16/ksearch/opus47_30r_ncu_hwspec"
            ]
        },
        {
            "name": "Compare RMSNorm+RoPE fp16 implementations",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/compare_kernels.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": true,
            "args": [
                "rmsnorm_rope_fp16/rmsnorm_rope_fp16.py",
                "rmsnorm_rope_fp16/opus47_30r",
                "rmsnorm_rope_fp16/opus47_30r_ncu_hwspec",
                "--precision", "fp16",
                "--warmup", "100",
                "--iters", "1000",
                "--atol", "1e-2",
                "--compile-mode", "default"
            ]
        }
    ]
}