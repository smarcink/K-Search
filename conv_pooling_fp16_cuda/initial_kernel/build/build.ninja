ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=ref_conv_pool_cuda -DTORCH_API_INCLUDE_EXTENSION_H -I/home/smarcink/WORK/K-Search/conv_pooling_fp16_cuda/initial_kernel -I/home/smarcink/WORK/K-Search/conv_pooling_fp16_cuda/initial_kernel/build -isystem /home/smarcink/WORK/K-Search/.venv/lib/python3.12/site-packages/torch/include -isystem /home/smarcink/WORK/K-Search/.venv/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -isystem /usr/local/cuda/include -isystem /home/smarcink/.local/share/uv/python/cpython-3.12.13-linux-x86_64-gnu/include/python3.12 -fPIC -std=c++17 -O3
post_cflags = 
cuda_cflags = -DTORCH_EXTENSION_NAME=ref_conv_pool_cuda -DTORCH_API_INCLUDE_EXTENSION_H -I/home/smarcink/WORK/K-Search/conv_pooling_fp16_cuda/initial_kernel -I/home/smarcink/WORK/K-Search/conv_pooling_fp16_cuda/initial_kernel/build -isystem /home/smarcink/WORK/K-Search/.venv/lib/python3.12/site-packages/torch/include -isystem /home/smarcink/WORK/K-Search/.venv/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -isystem /usr/local/cuda/include -isystem /home/smarcink/.local/share/uv/python/cpython-3.12.13-linux-x86_64-gnu/include/python3.12 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_120,code=compute_120 -gencode=arch=compute_120,code=sm_120 --compiler-options '-fPIC' -O3 --use_fast_math -std=c++17
cuda_post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/home/smarcink/WORK/K-Search/.venv/lib/python3.12/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/usr/local/cuda/lib64 -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc -MD -MF $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





rule link
  command = $cxx $in $ldflags -o $out

build main.o: compile /home/smarcink/WORK/K-Search/conv_pooling_fp16_cuda/initial_kernel/build/main.cpp
build cuda.cuda.o: cuda_compile /home/smarcink/WORK/K-Search/conv_pooling_fp16_cuda/initial_kernel/build/cuda.cu





build ref_conv_pool_cuda.so: link main.o cuda.cuda.o

default ref_conv_pool_cuda.so
